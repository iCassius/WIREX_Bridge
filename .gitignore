/build/
/.vs/
*.obj
*.pdb
*.ilk
*.exe
*.lib
*.exp

# User-provided radio/audio data and local diagnostics stay out of Git.
*.wav
*.pcm
*.adi
*.log
/.env
/.env.*
!/.env.example
/private/
/logs/
/tools/audio-settings.json
/tools/connection-profile.json
# 用户运行配置随便携目录移动；配置正文与原子写入期间的备份不进入 Git。
/config.json
/config.*.backup*
