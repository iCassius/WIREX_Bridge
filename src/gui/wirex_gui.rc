#pragma code_page(65001)

#include "resource.h"
#include "include/wirex/version_rc.h"

// 路径相对 rc.exe 的 /I 搜索路径（tools/build-gui.ps1 传入仓库根目录）。
IDI_WIREX_APP ICON "assets/wiresx-official.ico"

1 24 "src/gui/wirex_gui.manifest"

1 VERSIONINFO
 FILEVERSION WIREX_VERSION_MAJOR,WIREX_VERSION_MINOR,WIREX_VERSION_PATCH,0
 PRODUCTVERSION WIREX_VERSION_MAJOR,WIREX_VERSION_MINOR,WIREX_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", WIREX_AUTHOR
            VALUE "FileDescription", "WIREX Bridge"
            VALUE "FileVersion", WIREX_VERSION_STR
            VALUE "LegalCopyright", "© BI7KGD · GPL-3.0-or-later"
            VALUE "OriginalFilename", "WirexBridge.exe"
            VALUE "ProductName", "WIREX Bridge"
            VALUE "ProductVersion", WIREX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
