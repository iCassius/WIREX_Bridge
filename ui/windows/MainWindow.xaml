<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIREX Bridge · FTX-1"
        Width="1180" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#141719" Foreground="#EDF1F2"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="Background" Value="#30383E"/>
      <Setter Property="BorderBrush" Value="#536169"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#87A9B6"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#273238"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#252B2F"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#394147"/>
                <Setter Property="Foreground" Value="#778288"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#778288"/>
          <Setter Property="Background" Value="#252B2F"/>
          <Setter Property="BorderBrush" Value="#394147"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="Background" Value="#20252A"/>
      <Setter Property="BorderBrush" Value="#536169"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Grid Margin="{TemplateBinding BorderThickness}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="#252B2F" BorderThickness="0">
                  <Path Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z"/>
                </ToggleButton>
              </Grid>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#20252A" BorderBrush="#536169" BorderThickness="1" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Outer" Property="Background" Value="#20252A"/>
                <Setter Property="Foreground" Value="#778288"/>
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#87A9B6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#20252A"/>
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="Padding" Value="8,6"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#344148"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#355A42"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#191E21"/>
      <Setter Property="Foreground" Value="#C2CBD0"/>
      <Setter Property="BorderBrush" Value="#3A4248"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="108"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="WIREX BRIDGE · FTX-1 个人终端" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="状态根据当前核心运行报告更新；本地收听只控制本机过滤" Foreground="#9DA8AD" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
      <Button x:Name="ConnectButton" Grid.Column="1" Content="连接" MinWidth="90" Background="#355A42" BorderBrush="#55785F"/>
      <Button x:Name="SettingsButton" Grid.Column="2" Content="设置" MinWidth="90"/>
      <Button x:Name="StopButton" Grid.Column="3" Content="停止并退出" MinWidth="130" Background="#68412A" BorderBrush="#9C6843"/>
    </Grid>
    <Border x:Name="OfflineBanner" Grid.Row="1" Padding="12,8" Margin="0,0,0,10" Background="#493819" BorderBrush="#9B7635" BorderThickness="1" Visibility="Collapsed">
      <TextBlock x:Name="OfflineBannerText" Text="离线预览：没有连接设备或网络。" Foreground="#FFDD98" FontWeight="Bold"/>
    </Border>
    <UniformGrid x:Name="StatusCards" Grid.Row="2" Columns="4" Margin="0,0,0,10">
      <Border x:Name="CoreStatusCard" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="12" Margin="0,0,7,0">
        <StackPanel><TextBlock Text="核心" Foreground="#9DA8AD" FontSize="11"/><TextBlock x:Name="CoreValue" Text="未启动" FontSize="18" FontWeight="Bold" Margin="0,7,0,3"/><TextBlock x:Name="CoreDetail" Text="等待设置" Foreground="#9DA8AD" FontSize="11"/></StackPanel>
      </Border>
      <Border x:Name="RadioStatusCard" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="12" Margin="0,0,7,0">
        <StackPanel><TextBlock Text="FTX-1 / HRI" Foreground="#9DA8AD" FontSize="11"/><TextBlock x:Name="RadioValue" Text="未知" FontSize="18" FontWeight="Bold" Margin="0,7,0,3"/><TextBlock x:Name="RadioDetail" Text="串口与 HRI 等待核心报告" Foreground="#9DA8AD" FontSize="11"/></StackPanel>
      </Border>
      <Border x:Name="AudioStatusCard" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="12" Margin="0,0,7,0">
        <StackPanel><TextBlock Text="音频" Foreground="#9DA8AD" FontSize="11"/><TextBlock x:Name="AudioValue" Text="未知" FontSize="18" FontWeight="Bold" Margin="0,7,0,3"/><TextBlock x:Name="AudioDetail" Text="WaveIn / WaveOut 等待核心报告" Foreground="#9DA8AD" FontSize="11"/></StackPanel>
      </Border>
      <Border x:Name="BmStatusCard" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="12">
        <StackPanel><TextBlock Text="BrandMeister" Foreground="#9DA8AD" FontSize="11"/><TextBlock x:Name="BmValue" Text="未知" FontSize="18" FontWeight="Bold" Margin="0,7,0,3"/><TextBlock x:Name="BmDetail" Text="连接状态等待核心报告" Foreground="#9DA8AD" FontSize="11"/></StackPanel>
      </Border>
    </UniformGrid>
    <Border x:Name="DashboardPanel" Grid.Row="3" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="18" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="当前运行 / 下一发射" Foreground="#9DA8AD" FontSize="10"/><TextBlock x:Name="TargetValue" Text="尚未设置" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/><TextBlock x:Name="ReceiveTargetValue" Text="接收：等待配置" Foreground="#8CC9A1" FontSize="12" Margin="0,1,0,0"/><TextBlock x:Name="TransmitTargetValue" Text="下一发射目标：等待配置" Foreground="#8CC9A1" FontSize="12" Margin="0,1,0,0"/><TextBlock x:Name="TransmitPermissionValue" Text="发射许可：等待配置" Foreground="#E1AE53" FontSize="11" Margin="0,1,0,0"/><TextBlock x:Name="RoutingRevisionValue" Text="本机媒体状态：等待核心报告" Foreground="#9DA8AD" FontSize="10" Margin="0,1,0,0"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="下一发射目标" Foreground="#9DA8AD" FontSize="11"/><ComboBox x:Name="TargetSelector" Height="36" SelectedIndex="3">
            <ComboBoxItem Content="中国鹦鹉 · 私呼 460997" Tag="parrot-cn"/>
            <ComboBoxItem Content="全球收听 · TG91" Tag="listen-91"/>
            <ComboBoxItem Content="本地收听 · TG46001" Tag="listen-46001"/>
            <ComboBoxItem Content="使用已保存目标" Tag="custom"/>
          </ComboBox><TextBlock x:Name="ActiveLeaseValue" Text="当前发射目标：无" Foreground="#E1AE53" FontSize="11" Margin="0,2,0,0"/></StackPanel>
        </Grid>
        <Border x:Name="DynamicGroupPanel" Grid.Row="1" Background="#191E21" BorderBrush="#46545A" BorderThickness="1" Padding="4" Margin="0,6,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2.2*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="动态组控制" FontWeight="Bold" FontSize="12"/>
              <TextBlock x:Name="DynamicGroupHelpText" Text="本机收听与一次空组呼激活分开操作。" Foreground="#9DA8AD" FontSize="10"/>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="TG" Foreground="#AAB5BA" FontSize="10" VerticalAlignment="Center" Margin="3,0,5,0"/>
              <TextBox x:Name="DynamicGroupIdBox" Grid.Column="1" Background="#20252A" Foreground="#EDF1F2" BorderBrush="#536169" BorderThickness="1" Padding="7,4" ToolTip="手动输入组呼 TG；范围 1 到 16777215" VerticalAlignment="Center"/>
            </Grid>
            <ComboBox x:Name="DynamicGroupSlotBox" Grid.Column="2" SelectedIndex="1" Width="82" VerticalAlignment="Center" Margin="4,0">
              <ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/>
            </ComboBox>
            <Button x:Name="AddListenGroupButton" Grid.Column="3" Content="加入本机收听" MinWidth="108" Padding="7,4" Margin="4,0" IsEnabled="False" ToolTip="只更新本机 RX 允许规则，不发送网络控制包。"/>
            <Button x:Name="ActivateDynamicGroupButton" Grid.Column="4" Content="激活动态组" MinWidth="108" Padding="7,4" Margin="4,0" IsEnabled="False" ToolTip="只发送一次无语音 Quick Call；不会启用语音发射许可。"/>
            <TextBlock x:Name="DynamicGroupStatus" Grid.Column="5" Text="可加入本机收听，或发送动态组激活请求。" Foreground="#AAB5BA" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="10" Margin="0,0,7,0">
      <StackPanel><TextBlock Text="最近来话" Foreground="#9DA8AD" FontSize="11"/><TextBlock x:Name="RecentCaller" Text="—" FontSize="20" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock x:Name="RecentCallDetail" Text="当前会话没有来话记录" Foreground="#9DA8AD" TextWrapping="Wrap"/><TextBlock Text="HRI 来源标签" Foreground="#9DA8AD" FontSize="11" Margin="0,10,0,0"/><TextBlock x:Name="HriSourceIdentityValue" Text="等待本次运行报告" FontSize="13" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock x:Name="RadioDisplayValue" Text="FTX-1 屏幕：未知" Foreground="#E1AE53" FontSize="11" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border x:Name="TrafficCard" Grid.Column="1" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="6" Margin="7,0">
            <StackPanel><TextBlock Text="收发状态" Foreground="#9DA8AD" FontSize="11"/><TextBlock x:Name="TrafficValue" Text="等待核心状态" FontSize="18" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock x:Name="TrafficDetail" Text="下一发射目标可独立于本机收听策略设置。" Foreground="#9DA8AD" TextWrapping="Wrap"/><TextBlock x:Name="RadioStateValue" Text="电台状态：未知" Foreground="#E1AE53" FontSize="11" Margin="0,4,0,0"/><TextBlock x:Name="CurrentCallLabel" Text="当前 BM 来话" Foreground="#9DA8AD" FontSize="11" Margin="0,3,0,0"/><TextBlock x:Name="CurrentCallValue" Text="状态等待本次运行报告" FontSize="14" FontWeight="Bold" Margin="0,0,0,0"/><TextBlock x:Name="CurrentCallDetail" Text="当前没有可显示的活动来话。" Foreground="#9DA8AD" TextWrapping="Wrap"/><Button x:Name="BlockCurrentSourceButton" Content="本机屏蔽当前发话源" Padding="6,3" Margin="0,2,0,0" IsEnabled="False"/></StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="10" Margin="7,0,0,0">
            <DockPanel LastChildFill="True"><TextBlock Text="已配置接收路由" Foreground="#9DA8AD" FontSize="11" DockPanel.Dock="Top" Margin="0,0,0,5"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ConfiguredRoutesPanel"/></ScrollViewer></DockPanel>
          </Border>
          <Border Grid.Column="3" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="10" Margin="7,0,0,0">
            <DockPanel LastChildFill="True"><TextBlock Text="核心本次运行观察到的来源" Foreground="#9DA8AD" FontSize="11" DockPanel.Dock="Top" Margin="0,0,0,4"/><TextBlock Text="BM 来源：未知；本地停止收听只过滤本机，不会停止 BM 转发。" Foreground="#9DA8AD" FontSize="10" TextWrapping="Wrap" DockPanel.Dock="Bottom" Margin="0,4,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ObservedSourcesPanel"/></ScrollViewer></DockPanel>
          </Border>
          <Border Grid.Column="4" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="10" Margin="7,0,0,0">
        <StackPanel><TextBlock Text="运行会话" Foreground="#9DA8AD" FontSize="11"/><TextBlock x:Name="RunValue" Text="未启动" FontSize="16" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock x:Name="FreshnessValue" Text="没有状态报告" Foreground="#9DA8AD" TextWrapping="Wrap"/><TextBlock x:Name="ControlProtocolValue" Text="控制协议：等待" Foreground="#E1AE53" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,3"/><Button x:Name="ControlStatusButton" Content="查询状态" Height="26" Padding="8,1" HorizontalAlignment="Left" MinWidth="84" IsEnabled="False"/></StackPanel>
          </Border>
        </Grid>
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="运行记录" FontSize="12" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,14,0"/>
          <ListBox x:Name="EventList" Grid.Column="1" Height="94"/>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterText" Text="使用已保存的配置连接；关闭窗口将停止桥接并退出。" Foreground="#9DA8AD" FontSize="11" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="FTX-1 个人终端" Foreground="#9DA8AD" FontSize="11" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
