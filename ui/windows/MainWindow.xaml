<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIREX Bridge · FTX-1"
        Width="1360" Height="900" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#111619" Foreground="#EDF3F4"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#1D2529"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#151C20"/>
    <SolidColorBrush x:Key="LineBrush" Color="#46545B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B5BB"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#9BE0AE"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF3F4"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="2,1"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F4F5"/><Setter Property="Background" Value="#2B383E"/>
      <Setter Property="BorderBrush" Value="#718189"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B7D5DE"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26343A"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#20272B"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3D484D"/>
                <Setter Property="Foreground" Value="#8A969B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F2F6F7"/><Setter Property="Background" Value="#12191C"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,1"/>
      <Setter Property="MinHeight" Value="29"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
              <ContentPresenter x:Name="PART_SelectionBoxItem" Margin="7,0,29,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Margin="5,1,29,1" Padding="1,0" VerticalContentAlignment="Center"/>
              <ToggleButton x:Name="DropDownToggle" Width="25" HorizontalAlignment="Right" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ArrowChrome" Background="Transparent" CornerRadius="1">
                      <TextBlock Text="▾" Foreground="#E6EEF0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#34474F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#28533B"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#182126" BorderBrush="#64747C" BorderThickness="1" MaxHeight="240" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer Margin="1" CanContentScroll="True" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_SelectionBoxItem" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9BE0AE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#20272B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#3D484D"/><Setter Property="Foreground" Value="#8A969B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#182126"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="Padding" Value="7,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#34474F"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28533B"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#E6EEF0"/>
      <Setter Property="BorderBrush" Value="#526169"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF0"/>
      <Setter Property="Padding" Value="5,3"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28533B"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="#9BE0AE"/><Setter Property="Margin" Value="2,4,10,5"/>
      <Setter Property="SmallChange" Value="0.05"/><Setter Property="LargeChange" Value="0.5"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#EDF3F4"/><Setter Property="Background" Value="#172024"/>
      <Setter Property="BorderBrush" Value="#46545B"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="ConsoleRoot" Margin="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="45*"/><RowDefinition Height="55*"/></Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="WIREX BRIDGE  ·  FTX-1" FontSize="19" FontWeight="Bold"/>
        <TextBlock x:Name="FooterText" Text="" Foreground="#EFC36F" FontSize="12" Margin="1,1,0,0" Visibility="Collapsed"/>
      </StackPanel>
      <Button x:Name="SettingsButton" Grid.Column="1" Content="路由策略" MinWidth="88"/>
      <Button x:Name="StopButton" Grid.Column="2" Content="停止并退出" MinWidth="120" Background="#69422E" BorderBrush="#A06F4D"/>
    </Grid>

    <Grid x:Name="ConsoleTop" Grid.Row="1" Margin="0,0,0,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="OfflineBanner" Grid.Row="0" Padding="7,4" Margin="0,0,0,5" Background="#493819" BorderBrush="#9B7635" BorderThickness="1" Visibility="Collapsed">
        <TextBlock x:Name="OfflineBannerText" Text="" Foreground="#FFE0A1" FontWeight="Bold" FontSize="12"/>
      </Border>
      <UniformGrid x:Name="StatusCards" Grid.Row="1" Columns="4" Margin="0,0,0,6">
        <Border x:Name="CoreStatusCard" Background="#1D2529" BorderBrush="#3C4A50" BorderThickness="1" Padding="8" Margin="0,0,4,0">
          <StackPanel><DockPanel><TextBlock Text="核心" Foreground="#A8B5BB" FontSize="12"/><TextBlock x:Name="CoreValue" DockPanel.Dock="Right" Text="" FontSize="13" FontWeight="Bold"/></DockPanel><TextBlock x:Name="CoreDetail" Text="" FontSize="12" Foreground="#9BA9AE" Visibility="Collapsed"/></StackPanel>
        </Border>
        <Border x:Name="RadioStatusCard" Background="#1D2529" BorderBrush="#3C4A50" BorderThickness="1" Padding="8" Margin="2,0,3,0">
          <StackPanel><DockPanel><TextBlock Text="电台 / HRI" Foreground="#A8B5BB" FontSize="12"/><TextBlock x:Name="RadioValue" DockPanel.Dock="Right" Text="" FontSize="13" FontWeight="Bold"/></DockPanel><TextBlock x:Name="RadioDetail" Text="" FontSize="12" Foreground="#9BA9AE" Visibility="Collapsed"/></StackPanel>
        </Border>
        <Border x:Name="AudioStatusCard" Background="#1D2529" BorderBrush="#3C4A50" BorderThickness="1" Padding="8" Margin="2,0,3,0">
          <StackPanel><DockPanel><TextBlock Text="音频" Foreground="#A8B5BB" FontSize="12"/><TextBlock x:Name="AudioValue" DockPanel.Dock="Right" Text="" FontSize="13" FontWeight="Bold"/></DockPanel><TextBlock x:Name="AudioDetail" Text="" FontSize="12" Foreground="#9BA9AE" Visibility="Collapsed"/></StackPanel>
        </Border>
        <Border x:Name="BmStatusCard" Background="#1D2529" BorderBrush="#3C4A50" BorderThickness="1" Padding="8" Margin="2,0,0,0">
          <StackPanel>
            <DockPanel LastChildFill="True"><TextBlock Text="BrandMeister" Foreground="#A8B5BB" FontSize="12" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="BmValue" Text="" FontSize="13" FontWeight="Bold"/></DockPanel>
            <StackPanel x:Name="BmRttMetric" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,0">
              <TextBlock Text="往返" Foreground="#A8B5BB" FontSize="12" Margin="0,0,5,0"/><TextBlock x:Name="BmRttValue" Text="" FontSize="12" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock x:Name="BmDetail" Text="" FontSize="12" Foreground="#9BA9AE" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Grid.Row="2" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="10,8">
        <StackPanel>
            <TextBlock Text="当前来话 · 发话来源" Foreground="#A8B5BB" FontSize="12" FontWeight="Bold"/>
            <StackPanel x:Name="CurrentCallPanel" Visibility="Collapsed" Margin="0,3,0,0">
              <TextBlock x:Name="CurrentCallLabel" Text="来话" Foreground="#9FB2BA" FontSize="12"/>
              <TextBlock x:Name="CurrentCallValue" Text="" FontSize="34" FontWeight="Bold" Foreground="#9BE0AE" Margin="0,1,0,0"/>
              <TextBlock x:Name="CurrentCallDetail" Text="" Foreground="#D2DDE0" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock x:Name="IdentityLookupStatusValue" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
              <WrapPanel>
                <Button x:Name="QueryCurrentIdentityButton" Content="查询资料" Padding="7,3" Margin="0,2,4,0" IsEnabled="False" Visibility="Collapsed"/>
                <Button x:Name="BlockCurrentSourceButton" Content="屏蔽此来源" Padding="7,3" Margin="0,2,0,0" IsEnabled="False"/>
              </WrapPanel>
            </StackPanel>
            <Grid x:Name="RecentCallPanel" Visibility="Collapsed" Margin="0,2,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="最近来话" Foreground="#9FB2BA" FontSize="12"/><TextBlock x:Name="RecentCaller" Text="" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="RecentCallDetail" Text="" Foreground="#BCC8CC" FontSize="12" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Grid.Column="1" Visibility="Collapsed"><TextBlock Text="HRI 来源标签" Foreground="#9FB2BA" FontSize="12"/><TextBlock x:Name="HriSourceIdentityValue" Text="" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="RadioDisplayValue" Text="" Foreground="#EFC36F" FontSize="12"/></StackPanel>
            </Grid>
        </StackPanel>
      </Border>
      <Expander x:Name="RadioDetailsExpander" Grid.Row="3" IsExpanded="False" Visibility="Collapsed" HorizontalAlignment="Right" Background="#172024" Foreground="#EDF3F4" BorderBrush="#46545B" BorderThickness="1">
        <Expander.Header><TextBlock Text="来话历史 · 收听来源与屏蔽" FontSize="12" FontWeight="Bold"/></Expander.Header>
        <Grid Width="600" MaxHeight="240" Margin="3">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel x:Name="HistoryPanel" Grid.Row="0" LastChildFill="True" Margin="0,0,0,5" Visibility="Collapsed">
            <TextBlock Text="来话历史" Foreground="#A8B5BB" FontSize="12" Margin="0,2,8,0" DockPanel.Dock="Left"/>
            <ListBox x:Name="CallHistoryList" Height="68" DisplayMemberPath="text"/>
          </DockPanel>
          <Grid x:Name="HistoryActionsPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="SetHistoryCallTargetButton" Content="设为起呼目标" Width="102" Height="27" Padding="5,2" Margin="0,1,5,0" IsEnabled="False"/>
            <Button x:Name="QueryHistoryIdentityButton" Grid.Column="1" Content="查询资料" Width="80" Height="27" Padding="5,2" Margin="0,1,5,0" IsEnabled="False" Visibility="Collapsed"/>
            <ListBox x:Name="EventList" Grid.Column="2" Height="32" Visibility="Collapsed"/>
          </Grid>
          <Border x:Name="ObservedSourcesCard" Grid.Row="2" Background="#151C20" BorderBrush="#46545B" BorderThickness="1" Padding="5" Visibility="Collapsed">
            <DockPanel LastChildFill="True"><TextBlock Text="收听来源" Foreground="#A8B5BB" FontSize="12" DockPanel.Dock="Top" Margin="0,0,0,4"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ObservedSourcesPanel"/></ScrollViewer></DockPanel>
          </Border>
        </Grid>
      </Expander>
    </Grid>

    <Grid x:Name="DashboardPanel" Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>

      <Border x:Name="ConnectionConfigPanel" Grid.Column="0" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="8" Margin="0,0,7,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="ConnectionScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel Margin="1,0,0,4"><TextBlock Text="连接配置" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="DeviceDiscoveryText" DockPanel.Dock="Right" Text="" Foreground="#A8B5BB" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/></DockPanel>
            <TextBlock x:Name="ProfileMigrationText" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="呼号" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="CallsignBox"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Gateway ID" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="GatewayBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="本机 DMR ID" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="SourceBox"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="BM 服务器" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="MasterPresetBox" SelectedIndex="0"><ComboBoxItem Content="BM 4602 · 43.129.83.124" Tag="bm-china-4602"/><ComboBoxItem Content="自定义" Tag="custom"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="UDP 端口" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="MasterPortBox" Text="62031"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="主机名 / IPv4" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="MasterBox" Text="43.129.83.124"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="色码" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="ColorCodeBox"/></StackPanel>
            </Grid>
            <Border Background="#172024" BorderBrush="#3C494F" BorderThickness="1" Padding="5" Margin="0,2,0,3">
              <StackPanel>
                <DockPanel><TextBlock Text="设备端口" FontWeight="Bold" FontSize="12"/><Button x:Name="RefreshDevicesButton" Content="刷新" Padding="6,2" Margin="0"/></DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="HRI 串口" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="SerialBox"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="音频输入" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="WaveInEndpointBox"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="音频输出" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="WaveOutEndpointBox"/></StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border x:Name="RadioCatPanel" Background="#172024" BorderBrush="#3C494F" BorderThickness="1" Padding="5" Margin="0,2,0,3" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="FTX-1 CAT-1 端口" FontWeight="Bold" FontSize="12"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="CAT 串口" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="CatPortBox" IsEditable="True" IsTextSearchEnabled="False"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="波特率" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="CatBaudRateBox"><ComboBoxItem Content="4800" Tag="4800"/><ComboBoxItem Content="9600" Tag="9600"/><ComboBoxItem Content="19200" Tag="19200"/><ComboBoxItem Content="38400" Tag="38400"/><ComboBoxItem Content="115200" Tag="115200"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="停止位" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="CatStopBitsBox"><ComboBoxItem Content="1" Tag="One"/><ComboBoxItem Content="2" Tag="Two"/></ComboBox></StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="BM API Key 文件" Foreground="#A8B5BB" FontSize="12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="BmApiKeyPathBox" Margin="2,1,4,1"/>
                <Button x:Name="BrowseBmApiKeyButton" Grid.Column="1" Content="选择" Padding="6,3"/>
              </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1">
              <TextBlock Text="BM 密码文件" Foreground="#A8B5BB" FontSize="12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PasswordPathBox" Margin="2,1,4,1"/>
                <Button x:Name="BrowsePasswordButton" Grid.Column="1" Content="选择" Padding="6,3"/>
              </Grid>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="SettingsErrorText" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Margin="2,3" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
          <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ConnectButton" Content="连接并应用" MinWidth="110" Background="#28583C" BorderBrush="#64A477"/>
            <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="保存配置" MinWidth="88"/>
            <TextBlock x:Name="ConnectionLockValue" Grid.Column="2" Text="" Foreground="#A8B5BB" FontSize="12" VerticalAlignment="Center" Margin="6,0,1,0"/>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="DailyControlsPanel" Grid.Column="1" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="8" Margin="7,0,0,0">
        <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="日常控制" FontSize="14" FontWeight="Bold" Margin="1,0,0,4"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="ListeningHistoryPanel" Background="#151C20" BorderBrush="#3C494F" BorderThickness="1" Padding="7" Margin="0,0,3,0">
                <StackPanel><TextBlock Text="当前收听组" Foreground="#A8B5BB" FontSize="12"/><TextBlock x:Name="ReceiveTargetValue" Text="" Foreground="#9BE0AE" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <Border x:Name="TransmitTargetPanel" Grid.Column="1" Background="#151C20" BorderBrush="#3C494F" BorderThickness="1" Padding="7" Margin="3,0,0,0">
                <StackPanel>
                  <TextBlock Text="当前起呼目标" Foreground="#A8B5BB" FontSize="12"/>
                  <TextBlock x:Name="TransmitTargetValue" Text="" Foreground="#E6F4E9" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TransmitPermissionValue" Text="" Foreground="#EFC36F" FontSize="12" Margin="0,1,0,0"/>
                  <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="目标 ID" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="DestinationBox"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="时隙" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="SlotBox" MinWidth="76" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="类型" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="CallKindBox" MinWidth="76" SelectedIndex="1"><ComboBoxItem Content="组呼" Tag="group"/><ComboBoxItem Content="私呼" Tag="private"/></ComboBox></StackPanel>
                    <Button x:Name="ApplyNextTxTargetButton" Grid.Column="3" Content="应用" VerticalAlignment="Bottom" Padding="8,5"/>
                  </Grid>
                  <CheckBox x:Name="TransmitEnabledBox" Content="允许向 BM 发送" IsChecked="True" Foreground="#EDF3F4" Margin="3,2,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="TargetValue" Text="" Visibility="Collapsed"/>
            </Grid>
            <Border x:Name="DynamicGroupPanel" Background="#172024" BorderBrush="#46545B" BorderThickness="1" Padding="7" Margin="0,0,0,4">
              <StackPanel>
                <TextBlock Text="动态组" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
                <Grid>
