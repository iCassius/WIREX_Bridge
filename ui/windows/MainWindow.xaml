                    </Grid>
                    <ListBox x:Name="BmStaticGroupsList" Height="62" DisplayMemberPath="text"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
