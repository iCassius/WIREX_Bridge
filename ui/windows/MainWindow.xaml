<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIREX Bridge · FTX-1"
        Width="1360" Height="900" MinWidth="1360" MinHeight="900" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#111619" Foreground="#EDF3F4"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#1D2529"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#151C20"/>
    <SolidColorBrush x:Key="LineBrush" Color="#46545B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B5BB"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#9BE0AE"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF3F4"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="2,1"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="2,1"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F4F5"/><Setter Property="Background" Value="#2B383E"/>
      <Setter Property="BorderBrush" Value="#718189"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B7D5DE"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26343A"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#20272B"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3D484D"/>
                <Setter Property="Foreground" Value="#8A969B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F2F6F7"/><Setter Property="Background" Value="#12191C"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,1"/>
      <Setter Property="MinHeight" Value="29"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
              <ContentPresenter x:Name="PART_SelectionBoxItem" Margin="7,0,29,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Margin="5,1,29,1" Padding="1,0" VerticalContentAlignment="Center"/>
              <ToggleButton x:Name="DropDownToggle" Width="25" HorizontalAlignment="Right" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ArrowChrome" Background="Transparent" CornerRadius="1">
                      <TextBlock Text="▾" Foreground="#E6EEF0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#34474F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#28533B"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#182126" BorderBrush="#64747C" BorderThickness="1" MaxHeight="240" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer Margin="1" CanContentScroll="True" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_SelectionBoxItem" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9BE0AE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#20272B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#3D484D"/><Setter Property="Foreground" Value="#8A969B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#182126"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="Padding" Value="7,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#34474F"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28533B"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#E6EEF0"/>
      <Setter Property="BorderBrush" Value="#526169"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF0"/>
      <Setter Property="Padding" Value="3,1"/><Setter Property="FontSize" Value="10"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28533B"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="AudioGainSliderStyle" TargetType="Slider">
      <Setter Property="Foreground" Value="#4C7FF5"/><Setter Property="Margin" Value="2,4,6,4"/>
      <Setter Property="MinHeight" Value="34"/><Setter Property="Height" Value="34"/>
      <Setter Property="SmallChange" Value="0.05"/><Setter Property="LargeChange" Value="0.5"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="IsSnapToTickEnabled" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid x:Name="SliderRoot" SnapsToDevicePixels="True">
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="6"/></Grid.RowDefinitions>
              <Border x:Name="TrackRail" Grid.Row="0" Height="18" Margin="12,0" VerticalAlignment="Center" CornerRadius="9" Background="#56595E"/>
              <UniformGrid x:Name="TickDots" Grid.Row="0" Rows="1" Columns="7" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse Width="4" Height="4" Fill="#92959A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="4" Height="4" Fill="#92959A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="4" Height="4" Fill="#92959A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="4" Height="4" Fill="#92959A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="4" Height="4" Fill="#92959A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="4" Height="4" Fill="#92959A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="4" Height="4" Fill="#92959A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </UniformGrid>
              <Track x:Name="PART_Track" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False" Background="Transparent">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="SelectedTrack" Height="18" VerticalAlignment="Center" Background="#4C7FF5" CornerRadius="9"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectedTrack" Property="Background" Value="#858B91"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="PART_Thumb" Width="28" Height="28" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ThumbSurface" Fill="#FFFFFF" Stroke="#E9EBEE" StrokeThickness="1"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Fill" Value="#F1F4FF"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Fill" Value="#DDE7FF"/></Trigger>
                          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbSurface" Property="Fill" Value="#B8BEC3"/><Setter TargetName="ThumbSurface" Property="Stroke" Value="#747B80"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False" Background="Transparent">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TrackRail" Property="Background" Value="#42464A"/>
                <Setter TargetName="TickDots" Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="TrackRail" Property="BorderBrush" Value="#91B3FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#EDF3F4"/><Setter Property="Background" Value="#172024"/>
      <Setter Property="BorderBrush" Value="#46545B"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="ConsoleRoot" Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="370"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="MainTitleText" Text="WIREX BRIDGE  ·  FTX-1" Grid.Column="0" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <StackPanel x:Name="BmStatusCard" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
        <TextBlock Text="BrandMeister" Foreground="#A8B5BB" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="BmValue" Text="未连接" FontSize="13" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <StackPanel x:Name="BmRttMetric" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="RTT" Foreground="#A8B5BB" FontSize="12" Margin="0,0,4,0"/>
          <TextBlock x:Name="BmRttValue" Text="—" FontSize="12" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel x:Name="BmLossMetric" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
          <TextBlock Text="丢包" Foreground="#A8B5BB" FontSize="12" Margin="0,0,4,0"/>
          <TextBlock x:Name="BmLossValue" Text="" FontSize="12" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock x:Name="TransientStatusText" Text="" FontSize="11" Foreground="#EFC36F" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="390" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" ToolTipService.ShowDuration="30000" Visibility="Collapsed"/>
      </StackPanel>
      <Button x:Name="StopButton" Grid.Column="2" Content="停止并退出" MinWidth="120" Height="26" Padding="8,2" Margin="2,0" Background="#69422E" BorderBrush="#A06F4D" VerticalAlignment="Center"/>
    </Grid>

    <Grid x:Name="ConsoleTop" Grid.Row="1" Margin="0,0,0,6">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions>
      <Border x:Name="ChannelCardsScroll" Grid.Row="0" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="6" Margin="0,0,0,4">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <UniformGrid x:Name="ChannelCardsPanel" Grid.Row="0" Rows="2" Columns="3"/>
          <Grid x:Name="ChannelPageNav" Grid.Row="1" Height="20" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ChannelPagePreviousButton" Content="‹" Padding="8,0" MinWidth="28" Height="19"/>
            <TextBlock x:Name="ChannelPageText" Grid.Column="1" Text="" Foreground="#A8B5BB" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="ChannelPageNextButton" Grid.Column="2" Content="›" Padding="8,0" MinWidth="28" Height="19"/>
          </Grid>
        </Grid>
      </Border>
      <Border x:Name="RadioDetailsExpander" Grid.Row="1" Background="#172024" BorderBrush="#46545B" BorderThickness="1" Padding="3">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Text="来话历史" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,8,0"/>
          <Button x:Name="CallHistoryPagePreviousButton" Grid.Column="1" Content="‹" MinWidth="25" Height="24" Padding="4,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="CallHistoryPageText" Grid.Column="2" Text="1 / 1" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center" Margin="4,0"/>
          <Button x:Name="CallHistoryPageNextButton" Grid.Column="4" Content="›" MinWidth="25" Height="24" Padding="4,0" VerticalAlignment="Center"/>
          <Button x:Name="SetHistoryCallTargetButton" Grid.Column="5" Content="设为PTT目标" Width="94" Height="24" Padding="3,0" Margin="5,0,1,0" VerticalAlignment="Center" IsEnabled="False"/>
          <ListBox x:Name="CallHistoryList" Grid.Row="1" Grid.ColumnSpan="6" Height="82" FontSize="10" Padding="0" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Height" Value="16"/><Setter Property="MinHeight" Value="16"/><Setter Property="MaxHeight" Value="16"/>
                <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="11"/><Setter Property="VerticalContentAlignment" Value="Center"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding text}"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="DashboardPanel" Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

      <Border x:Name="ConnectionConfigPanel" Grid.Column="0" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="6" Margin="0,0,6,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ConnectionConfigTitleText" Text="连接配置" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="刷新设备" Width="62" Height="21" Padding="4,0" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Grid x:Name="ConnectionRowSerial" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Wires-X 串口" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center" Margin="2,0"/>
            <ComboBox x:Name="SerialBox" Grid.Row="1" Grid.Column="0" Height="29" Margin="2,0" VerticalAlignment="Center"/>
            <Grid x:Name="RadioCatPanel" Grid.RowSpan="2" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Text="CAT 串口" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center" Margin="2,0"/>
              <ComboBox x:Name="CatPortBox" Grid.Row="1" IsEditable="True" IsTextSearchEnabled="False" Height="29" Margin="2,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="波特率" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center" Margin="2,0"/>
              <ComboBox x:Name="CatBaudRateBox" Grid.Row="1" Grid.Column="1" Height="29" FontSize="11" Padding="3,2" Margin="2,0" VerticalAlignment="Center"><ComboBoxItem Content="4800" Tag="4800"/><ComboBoxItem Content="9600" Tag="9600"/><ComboBoxItem Content="19200" Tag="19200"/><ComboBoxItem Content="38400" Tag="38400"/><ComboBoxItem Content="115200" Tag="115200"/></ComboBox>
            </Grid>
            <Button x:Name="SerialConnectButton" Grid.Row="1" Grid.Column="2" Content="连接串口" Height="29" Margin="2,0" Padding="5,2" VerticalAlignment="Center" Background="#28583C" BorderBrush="#64A477"/>
          </Grid>
          <Grid x:Name="CatOperatingPanel" Grid.Row="2" Height="58" Margin="1,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="3,0">
              <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="29"/></Grid.RowDefinitions>
              <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CatModeCaptionText" Text="MAIN 模式" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel x:Name="CatObservedPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="CatObservedMainModeText" Text="" Foreground="#9BE0AE" FontSize="10"/></StackPanel>
              </Grid>
              <ComboBox x:Name="CatMainModeBox" Grid.Row="1" SelectedIndex="-1" Height="29" Margin="0"><ComboBoxItem Content="FM" Tag="FM"/><ComboBoxItem Content="FM-N" Tag="FM-N"/><ComboBoxItem Content="C4FM-DN" Tag="C4FM-DN"/><ComboBoxItem Content="C4FM-VW" Tag="C4FM-VW"/></ComboBox>
            </Grid>
            <Grid Grid.Column="1" Margin="3,0">
              <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="29"/></Grid.RowDefinitions>
              <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CatFrequencyCaptionText" Text="频率 MHz" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="CatObservedFrequencyText" Grid.Column="2" Text="" Foreground="#9BE0AE" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <ComboBox x:Name="CatMainFrequencyMHzBox" Grid.Row="1" IsEditable="True" IsTextSearchEnabled="False" SelectedIndex="-1" Height="29" Margin="0"/>
            </Grid>
            <Grid Grid.Column="2" Margin="3,0">
              <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="29"/></Grid.RowDefinitions>
              <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CatPowerCaptionText" Text="功率 W" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="CatObservedPowerText" Grid.Column="1" Text="" Foreground="#9BE0AE" FontSize="10" Margin="4,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <Button x:Name="ApplyCatSettingsButton" Grid.Column="2" Content="应用" Width="64" Height="24" Margin="0" Padding="5,1" VerticalAlignment="Center"/>
              </Grid>
              <ComboBox x:Name="CatPowerBox" Grid.Row="1" SelectedIndex="3" Height="29" Margin="0"><ComboBoxItem Content="5 W" Tag="5"/><ComboBoxItem Content="10 W" Tag="10"/><ComboBoxItem Content="15 W" Tag="15"/><ComboBoxItem Content="25 W" Tag="25"/><ComboBoxItem Content="50 W" Tag="50"/></ComboBox>
            </Grid>
          </Grid>
          <Grid x:Name="ConnectionRowIdentity" Grid.Row="3" Margin="0,0,0,1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="呼号" Foreground="#A8B5BB" FontSize="10"/><TextBox x:Name="CallsignBox" Height="27"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="DMR ID" Foreground="#A8B5BB" FontSize="10"/><TextBox x:Name="SourceBox" Height="27"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="设备编号" Foreground="#A8B5BB" FontSize="10"/><TextBox x:Name="DeviceNumberBox" MaxLength="2" TextAlignment="Center" ToolTip="00–99。旧 Gateway 无法拆分时留空；未编辑时保留原值。" Height="27"/></StackPanel>
          </Grid>
          <Grid x:Name="ConnectionRowServer" Grid.Row="4" Margin="0,0,0,1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="BM 服务器" Foreground="#A8B5BB" FontSize="10"/><ComboBox x:Name="MasterPresetBox" SelectedIndex="0" Height="27"><ComboBoxItem Content="BM 4602" Tag="bm-china-4602"/><ComboBoxItem Content="自定义" Tag="custom"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="UDP 端口" Foreground="#A8B5BB" FontSize="10"/><TextBox x:Name="MasterPortBox" Text="62031" Height="27"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="主机名 / IPv4" Foreground="#A8B5BB" FontSize="10"/><TextBox x:Name="MasterBox" Text="43.129.83.124" Height="27"/></StackPanel>
          </Grid>
          <Grid x:Name="ConnectionRowSecrets" Grid.Row="5" Margin="0,0,0,1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Foreground="#A8B5BB" FontSize="10"><Run Text="BM API Key  "/><Hyperlink x:Name="BmApiKeySetupLink" Tag="bm_api_key" Foreground="#9BE0AE"><Run Text="设置"/></Hyperlink></TextBlock><PasswordBox x:Name="BmApiKeyBox" Height="27"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Foreground="#A8B5BB" FontSize="10"><Run Text="BM 密码  "/><Hyperlink x:Name="BmPasswordSetupLink" Tag="bm_password" Foreground="#9BE0AE"><Run Text="设置"/></Hyperlink></TextBlock><PasswordBox x:Name="PasswordBox" Height="27"/></StackPanel>
          </Grid>
          <Grid x:Name="ConnectionRowActions" Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Button x:Name="ConnectButton" Content="连接BM" Height="29" Background="#28583C" BorderBrush="#64A477"/>
            <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="保存配置" Height="29"/>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="DailyControlsPanel" Grid.Column="1" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="6" Margin="6,0,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="55"/><RowDefinition Height="120"/><RowDefinition Height="65"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="日常控制" FontSize="13" FontWeight="Bold" Margin="1,0,0,1" VerticalAlignment="Center"/>
          <Grid x:Name="ChannelConsolePanel" Grid.Row="1" Margin="2,1,2,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="频道 ID" Grid.Row="0" Foreground="#A8B5BB" FontSize="10"/><ComboBox x:Name="ChannelIdBox" Grid.Row="1" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" Height="29" Margin="2,0" VerticalAlignment="Bottom"><ComboBoxItem Content="460997 中国鹦鹉" Tag="460997|private" TextSearch.Text="460997"/><ComboBoxItem Content="46001 组呼" Tag="46001|group" TextSearch.Text="46001"/><ComboBoxItem Content="91 组呼" Tag="91|group" TextSearch.Text="91"/></ComboBox></Grid>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="类型" Grid.Row="0" Foreground="#A8B5BB" FontSize="10"/><ComboBox x:Name="ChannelKindBox" Grid.Row="1" SelectedIndex="0" Height="29" Margin="2,0" VerticalAlignment="Bottom"><ComboBoxItem Content="请选择" Tag="unknown"/><ComboBoxItem Content="单呼" Tag="private"/><ComboBoxItem Content="组呼" Tag="group"/></ComboBox></Grid>
            <Button x:Name="AddChannelButton" Grid.Column="2" Content="加入监听" Padding="8,4" Background="#28583C" BorderBrush="#64A477" VerticalAlignment="Bottom" Height="29" Margin="2,0"/>
          </Grid>
          <Grid x:Name="BmStaticGroupPanel" Grid.Row="2" Margin="2,1,2,1" Visibility="Visible">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="58"/><RowDefinition Height="28"/></Grid.RowDefinitions>
              <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="BM 静态组" FontSize="11" Foreground="#A8B5BB" VerticalAlignment="Center" Margin="1,0,4,0"/>
                <TextBlock x:Name="BmStaticGroupSourceValue" Grid.Column="1" Text="" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="BmStaticGroupPagePreviousButton" Grid.Column="2" Content="‹" MinWidth="25" Height="19" Padding="3,0"/>
                <TextBlock x:Name="BmStaticGroupPageText" Grid.Column="3" Text="1 / 1" Foreground="#A8B5BB" FontSize="10" VerticalAlignment="Center" Margin="3,0"/>
                <Button x:Name="BmStaticGroupPageNextButton" Grid.Column="4" Content="›" MinWidth="25" Height="19" Padding="3,0"/>
                <Button x:Name="RefreshBmStaticGroupsButton" Grid.Column="5" Content="刷新" Padding="5,1" Height="19" Margin="3,1"/>
                <Button x:Name="RemoveBmStaticGroupButton" Grid.Column="6" Content="移除" Padding="5,1" Height="19" Margin="1" IsEnabled="False"/>
            </Grid>
              <Grid Grid.Row="1">
                <ListBox x:Name="BmStaticGroupsList" Height="58" FontSize="10" Background="#12191C" Foreground="#E6EEF0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding talkgroup, StringFormat='TG {0}'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding talkgroup}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid x:Name="StaticApiRequiredOverlay" Background="#151C20" IsHitTestVisible="False" Visibility="Visible">
                  <TextBlock x:Name="StaticApiRequiredText" Text="需启用BM API key" Foreground="#A8B5BB" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Grid>
              </Grid>
              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="BmStaticGroupIdBox" Grid.Column="0" ToolTip="TG" Height="25"/>
                <Button x:Name="AddBmStaticGroupButton" Grid.Column="1" Content="添加" Padding="7,2" Height="25" IsEnabled="False"/>
              </Grid>
            </Grid>
          </Grid>
          <Grid x:Name="AudioDevicePanel" Grid.Row="3" Margin="2,1,2,1">
            <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="音频设备" Foreground="#A8B5BB" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
            <Grid x:Name="ConnectionRowAudio" Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="输入" Foreground="#A8B5BB" FontSize="10"/><ComboBox x:Name="WaveInEndpointBox" Height="27"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="输出" Foreground="#A8B5BB" FontSize="10"/><ComboBox x:Name="WaveOutEndpointBox" Height="27"/></StackPanel>
            </Grid>
          </Grid>
          <Grid x:Name="VolumeControlsPanel" Grid.Row="4" Margin="2,2,2,1">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="音量" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="1,0,6,0">
                  <DockPanel><TextBlock Text="播放增益" Foreground="#A8B5BB" FontSize="10"/><TextBlock x:Name="PlaybackGainValueText" DockPanel.Dock="Right" Text="" Foreground="#9BE0AE" FontWeight="Bold" Margin="0,0,4,0" FontSize="10"/></DockPanel>
                  <Slider x:Name="PlaybackGainSlider" Style="{StaticResource AudioGainSliderStyle}" Minimum="0.25" Maximum="16" Value="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,1,0">
                  <DockPanel><TextBlock Text="发送增益" Foreground="#A8B5BB" FontSize="10"/><TextBlock x:Name="TransmitGainValueText" DockPanel.Dock="Right" Text="" Foreground="#9BE0AE" FontWeight="Bold" Margin="0,0,4,0" FontSize="10"/></DockPanel>
                  <Slider x:Name="TransmitGainSlider" Style="{StaticResource AudioGainSliderStyle}" Minimum="0.25" Maximum="16" Value="16"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
