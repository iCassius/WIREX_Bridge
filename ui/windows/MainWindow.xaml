<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIREX Bridge · FTX-1"
        Width="1180" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#141719" Foreground="#EDF1F2"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="Background" Value="#30383E"/>
      <Setter Property="BorderBrush" Value="#536169"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#87A9B6"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#273238"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#252B2F"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#394147"/>
                <Setter Property="Foreground" Value="#778288"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#778288"/>
          <Setter Property="Background" Value="#252B2F"/>
          <Setter Property="BorderBrush" Value="#394147"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="Background" Value="#20252A"/>
      <Setter Property="BorderBrush" Value="#536169"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Grid Margin="{TemplateBinding BorderThickness}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="#252B2F" BorderThickness="0">
                  <Path Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z"/>
                </ToggleButton>
              </Grid>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#20252A" BorderBrush="#536169" BorderThickness="1" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Outer" Property="Background" Value="#20252A"/>
                <Setter Property="Foreground" Value="#778288"/>
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#87A9B6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#20252A"/>
      <Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="Padding" Value="8,6"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#344148"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#355A42"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#191E21"/>
      <Setter Property="Foreground" Value="#C2CBD0"/>
      <Setter Property="BorderBrush" Value="#3A4248"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="WIREX BRIDGE · FTX-1" FontSize="19" FontWeight="Bold"/>
        <TextBlock x:Name="FooterText" Text="" Foreground="#E1AE53" FontSize="10" Margin="0,2,0,0"/>
      </StackPanel>
      <Button x:Name="ConnectButton" Grid.Column="1" Content="连接" MinWidth="90" Background="#355A42" BorderBrush="#55785F"/>
      <Button x:Name="SettingsButton" Grid.Column="2" Content="设置" MinWidth="90"/>
      <Button x:Name="StopButton" Grid.Column="3" Content="停止并退出" MinWidth="130" Background="#68412A" BorderBrush="#9C6843"/>
    </Grid>
    <Border x:Name="OfflineBanner" Grid.Row="1" Padding="8,5" Margin="0,0,0,6" Background="#493819" BorderBrush="#9B7635" BorderThickness="1" Visibility="Collapsed">
      <TextBlock x:Name="OfflineBannerText" Text="" Foreground="#FFDD98" FontWeight="Bold" FontSize="10"/>
    </Border>
    <UniformGrid x:Name="StatusCards" Grid.Row="2" Columns="3" Margin="0,0,0,7">
      <Border x:Name="CoreStatusCard" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="7" Margin="0,0,5,0">
        <StackPanel><DockPanel LastChildFill="True"><TextBlock Text="核心" Foreground="#9DA8AD" FontSize="10" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="CoreValue" Text="" FontSize="12" FontWeight="Bold"/></DockPanel><TextBlock x:Name="CoreDetail" Text="" Visibility="Collapsed"/></StackPanel>
      </Border>
      <Border x:Name="RadioStatusCard" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="7" Margin="0,0,5,0">
        <StackPanel><DockPanel LastChildFill="True"><TextBlock Text="HRI" Foreground="#9DA8AD" FontSize="10" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="RadioValue" Text="" FontSize="12" FontWeight="Bold"/></DockPanel><TextBlock x:Name="RadioDetail" Text="" Visibility="Collapsed"/></StackPanel>
      </Border>
      <Border x:Name="BmStatusCard" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="7">
        <StackPanel><DockPanel LastChildFill="True"><TextBlock Text="BM" Foreground="#9DA8AD" FontSize="10" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="BmValue" Text="" FontSize="12" FontWeight="Bold"/></DockPanel><TextBlock x:Name="BmDetail" Text="" Visibility="Collapsed"/></StackPanel>
      </Border>
    </UniformGrid>
    <Border x:Name="DashboardPanel" Grid.Row="3" Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="8" Margin="0,0,0,10">
      <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <Border x:Name="ListeningHistoryPanel" Grid.Column="0" Background="#191E21" BorderBrush="#46545A" BorderThickness="1" Padding="10" Margin="0,0,6,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="当前收听" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
              <TextBlock x:Name="ReceiveTargetValue" Grid.Row="1" Text="" Foreground="#8CC9A1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
              <StackPanel x:Name="CurrentCallPanel" Grid.Row="2" Margin="0,0,0,5" Visibility="Collapsed">
                <TextBlock x:Name="CurrentCallLabel" Text="当前来话" Foreground="#9DA8AD" FontSize="10"/>
                <TextBlock x:Name="CurrentCallValue" Text="" FontSize="15" FontWeight="Bold" Margin="0,1,0,0"/>
                <TextBlock x:Name="CurrentCallDetail" Text="" Foreground="#9DA8AD" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock x:Name="IdentityLookupStatusValue" Text="" Foreground="#E1AE53" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                <WrapPanel>
                  <Button x:Name="QueryCurrentIdentityButton" Content="查询当前资料" Padding="6,2" Margin="0,2,4,0" IsEnabled="False" Visibility="Collapsed"/>
                  <Button x:Name="BlockCurrentSourceButton" Content="屏蔽当前来源" Padding="6,2" Margin="0,2,0,0" IsEnabled="False"/>
                </WrapPanel>
              </StackPanel>
              <Grid x:Name="RecentCallPanel" Grid.Row="3" Margin="0,2,0,4" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="最近来话" Foreground="#9DA8AD" FontSize="10"/><TextBlock x:Name="RecentCaller" Text="" FontSize="14" FontWeight="Bold" Margin="0,1,0,0"/><TextBlock x:Name="RecentCallDetail" Text="" Foreground="#9DA8AD" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed"><TextBlock Text="HRI 来源标签" Foreground="#9DA8AD" FontSize="10"/><TextBlock x:Name="HriSourceIdentityValue" Text="" FontSize="12" FontWeight="Bold" Margin="0,1,0,0"/><TextBlock x:Name="RadioDisplayValue" Text="" Foreground="#E1AE53" FontSize="10" Margin="0,2,0,0"/></StackPanel>
              </Grid>
              <DockPanel x:Name="HistoryPanel" Grid.Row="4" LastChildFill="True" Margin="0,1,0,2" Visibility="Collapsed">
                <TextBlock Text="来话历史" FontSize="10" FontWeight="Bold" VerticalAlignment="Top" Margin="0,2,8,2" DockPanel.Dock="Top"/>
                <ListBox x:Name="CallHistoryList" Height="76" DisplayMemberPath="text"/>
              </DockPanel>
              <Grid x:Name="HistoryActionsPanel" Grid.Row="5" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="SetHistoryCallTargetButton" Content="设为起呼目标" Width="98" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,2" Margin="0,1,5,0" IsEnabled="False"/>
                <Button x:Name="QueryHistoryIdentityButton" Grid.Column="1" Content="查询资料" Width="92" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,2" Margin="0,1,5,0" IsEnabled="False" Visibility="Collapsed"/>
                <ListBox x:Name="EventList" Height="42" Visibility="Collapsed"/>
              </Grid>
            </Grid>
          </Border>
          <Border x:Name="CallChannelPanel" Grid.Column="1" Background="#191E21" BorderBrush="#46545A" BorderThickness="1" Padding="10" Margin="6,0,0,0">
            <StackPanel>
              <TextBlock Text="起呼目标" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
              <TextBlock x:Name="TargetValue" Text="" Visibility="Collapsed"/>
              <TextBlock x:Name="TransmitTargetValue" Text="" Foreground="#8CC9A1" FontSize="14" FontWeight="Bold" Margin="0,1,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="TransmitPermissionValue" Text="" Foreground="#E1AE53" FontSize="10" Margin="0,1,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="预设" Foreground="#9DA8AD" FontSize="10" VerticalAlignment="Center"/>
                <ComboBox x:Name="TargetSelector" Height="29" MinWidth="175" SelectedIndex="1">
                  <ComboBoxItem Content="鹦鹉私呼 · 460997 · TS2" Tag="parrot-cn"/>
                  <ComboBoxItem Content="当前已保存频道" Tag="custom"/>
                </ComboBox>
              </StackPanel>
              <TextBlock x:Name="CallTargetChoicesLabel" Text="本机目标" Foreground="#9DA8AD" FontSize="10" FontWeight="Bold" Margin="0,3,0,1" Visibility="Collapsed"/>
              <ScrollViewer x:Name="CallTargetChoicesScroll" MaxHeight="46" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><WrapPanel x:Name="CallTargetChoicesPanel"/></ScrollViewer>
              <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="92"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="分类" Foreground="#9DA8AD" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="FavoriteCategorySelector" Grid.Column="1" Height="25" SelectedIndex="0" Margin="0,0,4,0">
                  <ComboBoxItem Content="普通" Tag="normal"/><ComboBoxItem Content="动态" Tag="dynamic"/><ComboBoxItem Content="静态" Tag="static"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="名称" Foreground="#9DA8AD" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="FavoriteLabelBox" Grid.Column="3" Height="25" Padding="5,2" Margin="0" Background="#20252A" Foreground="#EDF1F2" BorderBrush="#536169" BorderThickness="1"/>
              </Grid>
              <WrapPanel Margin="-2,0,0,0">
                <Button x:Name="FavoriteCurrentTargetButton" Content="收藏当前起呼目标" Padding="5,2" Margin="2" IsEnabled="False"/>
                <Button x:Name="FavoriteManualGroupButton" Content="收藏输入TG/TS" Padding="5,2" Margin="2"/>
              </WrapPanel>
              <ListBox x:Name="CallFavoritesList" Height="52" DisplayMemberPath="text" Visibility="Collapsed"/>
              <WrapPanel Margin="-2,0,0,0">
                <Button x:Name="ApplyCallFavoriteButton" Content="设为呼叫目标" Padding="5,2" Margin="2" IsEnabled="False"/>
                <Button x:Name="RemoveCallFavoriteButton" Content="删除收藏" Padding="5,2" Margin="2" IsEnabled="False"/>
                <TextBlock x:Name="ChannelFavoritesStatusValue" Text="" Foreground="#E1AE53" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,1" Visibility="Collapsed"/>
              </WrapPanel>
                <TextBlock x:Name="ActiveLeaseValue" Text="" Foreground="#E1AE53" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="RoutingRevisionValue" Text="" Visibility="Collapsed"/>
              <TextBlock x:Name="CallTargetStatusValue" Text="" Foreground="#E1AE53" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="DynamicGroupPanel" Grid.Row="1" Background="#191E21" BorderBrush="#46545A" BorderThickness="1" Padding="5" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="TG / TS 快速操作" FontWeight="Bold" FontSize="11"/>
              <TextBlock x:Name="DynamicGroupHelpText" Text="" Visibility="Collapsed"/>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="TG" Foreground="#AAB5BA" FontSize="10" VerticalAlignment="Center" Margin="3,0,5,0"/>
              <TextBox x:Name="DynamicGroupIdBox" Grid.Column="1" Background="#20252A" Foreground="#EDF1F2" BorderBrush="#536169" BorderThickness="1" Padding="7,4" VerticalAlignment="Center"/>
            </Grid>
            <ComboBox x:Name="DynamicGroupSlotBox" Grid.Column="2" SelectedIndex="1" Width="74" VerticalAlignment="Center" Margin="3,0">
              <ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/>
            </ComboBox>
            <Button x:Name="SetDynamicCallTargetButton" Grid.Column="3" Content="设为起呼目标" MinWidth="96" Padding="6,4" Margin="2" IsEnabled="False"/>
            <Button x:Name="AddListenGroupButton" Grid.Column="4" Content="加入本机收听" MinWidth="96" Padding="6,4" Margin="2" IsEnabled="False"/>
            <Button x:Name="ActivateDynamicGroupButton" Grid.Column="5" Content="激活动态组" MinWidth="86" Padding="6,4" Margin="2" IsEnabled="False"/>
            <TextBlock x:Name="DynamicGroupStatus" Grid.Column="6" Text="" Foreground="#E1AE53" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <Expander x:Name="RadioDetailsExpander" Grid.Row="2" IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,0" Background="#191E21" Foreground="#EDF1F2" BorderBrush="#46545A" BorderThickness="1">
          <Expander.Header><TextBlock Text="收听来源" FontSize="11" FontWeight="Bold"/></Expander.Header>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
          <Border x:Name="TrafficCard" Grid.Column="0" Visibility="Collapsed" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="8" Margin="0,0,6,0">
            <StackPanel><TextBlock Text="收发状态" Foreground="#9DA8AD" FontSize="10"/><TextBlock x:Name="TrafficValue" Text="" FontSize="15" FontWeight="Bold" Margin="0,3,0,1"/><TextBlock x:Name="TrafficDetail" Text="" Foreground="#9DA8AD" FontSize="10" TextWrapping="Wrap"/><TextBlock x:Name="RadioStateValue" Text="" Foreground="#E1AE53" FontSize="10" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="1" Visibility="Collapsed" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="8" Margin="6,0">
            <DockPanel LastChildFill="True"><TextBlock Text="本机接收路由" Foreground="#9DA8AD" FontSize="10" DockPanel.Dock="Top" Margin="0,0,0,5"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ConfiguredRoutesPanel"/></ScrollViewer></DockPanel>
          </Border>
          <Border x:Name="ObservedSourcesCard" Grid.Column="0" Grid.ColumnSpan="4" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="8" Margin="0">
            <DockPanel LastChildFill="True"><TextBlock Text="收听来源" Foreground="#9DA8AD" FontSize="10" DockPanel.Dock="Top" Margin="0,0,0,4"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ObservedSourcesPanel"/></ScrollViewer></DockPanel>
          </Border>
          <Border Grid.Column="3" Visibility="Collapsed" Background="#191E21" BorderBrush="#343D42" BorderThickness="1" Padding="8" Margin="6,0,0,0">
            <StackPanel><TextBlock Text="运行会话" Foreground="#9DA8AD" FontSize="10"/><TextBlock x:Name="RunValue" Text="" FontSize="15" FontWeight="Bold" Margin="0,6,0,3"/><TextBlock x:Name="FreshnessValue" Text="" Foreground="#9DA8AD" FontSize="10" TextWrapping="Wrap"/><TextBlock x:Name="ControlProtocolValue" Text="" Foreground="#E1AE53" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,3"/><Button x:Name="ControlStatusButton" Content="查询状态" Height="26" Padding="8,1" HorizontalAlignment="Left" MinWidth="84" IsEnabled="False"/></StackPanel>
          </Border>
          <Border x:Name="AudioStatusCard" Grid.Column="3" Visibility="Collapsed"><StackPanel><TextBlock x:Name="AudioValue" Text=""/><TextBlock x:Name="AudioDetail" Text=""/></StackPanel></Border>
        </Grid>
        </Expander>
      </Grid>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="BmRttMetric" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="往返" Foreground="#9DA8AD" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock x:Name="BmRttValue" Text="" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel x:Name="RxNetworkMetric" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="丢包" Foreground="#9DA8AD" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock x:Name="RxCallLossValue" Text="" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock x:Name="RxSessionLossValue" Text="" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
      </StackPanel>
      <TextBlock x:Name="PlaybackGainStatusValue" Grid.Column="2" Text="" Foreground="#8CC9A1" FontSize="9" VerticalAlignment="Center" Margin="3,0,5,0" Visibility="Collapsed"/>
      <Button x:Name="VolumeSettingsButton" Grid.Column="3" Content="音量" MinWidth="64" Padding="7,4" Margin="2"/>
    </Grid>
  </Grid>
</Window>
