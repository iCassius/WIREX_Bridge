<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIREX Bridge · FTX-1"
        Width="1360" Height="900" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#111619" Foreground="#EDF3F4"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#1D2529"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#151C20"/>
    <SolidColorBrush x:Key="LineBrush" Color="#46545B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B5BB"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#9BE0AE"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF3F4"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="2,1"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="2,1"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F4F5"/><Setter Property="Background" Value="#2B383E"/>
      <Setter Property="BorderBrush" Value="#718189"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B7D5DE"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26343A"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#20272B"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3D484D"/>
                <Setter Property="Foreground" Value="#8A969B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F2F6F7"/><Setter Property="Background" Value="#12191C"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,1"/>
      <Setter Property="MinHeight" Value="29"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
              <ContentPresenter x:Name="PART_SelectionBoxItem" Margin="7,0,29,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Margin="5,1,29,1" Padding="1,0" VerticalContentAlignment="Center"/>
              <ToggleButton x:Name="DropDownToggle" Width="25" HorizontalAlignment="Right" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ArrowChrome" Background="Transparent" CornerRadius="1">
                      <TextBlock Text="▾" Foreground="#E6EEF0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#34474F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#28533B"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#182126" BorderBrush="#64747C" BorderThickness="1" MaxHeight="240" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer Margin="1" CanContentScroll="True" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_SelectionBoxItem" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9BE0AE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#20272B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#3D484D"/><Setter Property="Foreground" Value="#8A969B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#182126"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="Padding" Value="7,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#34474F"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28533B"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#E6EEF0"/>
      <Setter Property="BorderBrush" Value="#526169"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF0"/>
      <Setter Property="Padding" Value="5,3"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28533B"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="#9BE0AE"/><Setter Property="Margin" Value="2,4,10,5"/>
      <Setter Property="SmallChange" Value="0.05"/><Setter Property="LargeChange" Value="0.5"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#EDF3F4"/><Setter Property="Background" Value="#172024"/>
      <Setter Property="BorderBrush" Value="#46545B"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="ConsoleRoot" Margin="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="50*"/><RowDefinition Height="50*"/></Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="MainTitleText" Text="WIREX BRIDGE  ·  FTX-1" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
      <StackPanel x:Name="BmStatusCard" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0" Visibility="Collapsed">
        <TextBlock Text="BrandMeister" Foreground="#A8B5BB" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="BmValue" Text="" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <StackPanel x:Name="BmRttMetric" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="往返" Foreground="#A8B5BB" FontSize="12" Margin="0,0,4,0"/>
          <TextBlock x:Name="BmRttValue" Text="" FontSize="12" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock x:Name="BmDetail" Text="" FontSize="12" Foreground="#9BA9AE" Visibility="Collapsed"/>
      </StackPanel>
      <Button x:Name="StopButton" Grid.Column="3" Content="停止并退出" MinWidth="120" Background="#69422E" BorderBrush="#A06F4D"/>
      <TextBlock x:Name="FooterText" Grid.Row="1" Grid.ColumnSpan="4" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Margin="1,1,0,0" Visibility="Collapsed"/>
    </Grid>

    <Grid x:Name="ConsoleTop" Grid.Row="1" Margin="0,0,0,8" MinHeight="330">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="OfflineBanner" Grid.Row="0" Padding="7,4" Margin="0,0,0,5" Background="#493819" BorderBrush="#9B7635" BorderThickness="1" Visibility="Collapsed">
        <TextBlock x:Name="OfflineBannerText" Text="" Foreground="#FFE0A1" FontWeight="Bold" FontSize="12"/>
      </Border>
      <Border x:Name="ChannelCardsScroll" Grid.Row="1" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="7" Margin="0,0,0,5">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <UniformGrid x:Name="ChannelCardsPanel" Grid.Row="0" Rows="2" Columns="3"/>
          <Grid x:Name="ChannelPageNav" Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ChannelPagePreviousButton" Content="‹" Padding="10,2" MinWidth="36"/>
            <TextBlock x:Name="ChannelPageText" Grid.Column="1" Text="" Foreground="#A8B5BB" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="ChannelPageNextButton" Grid.Column="2" Content="›" Padding="10,2" MinWidth="36"/>
          </Grid>
        </Grid>
      </Border>
      <Expander x:Name="RadioDetailsExpander" Grid.Row="2" IsExpanded="False" HorizontalAlignment="Stretch" Background="#172024" Foreground="#EDF3F4" BorderBrush="#46545B" BorderThickness="1">
        <Expander.Header><TextBlock Text="来话历史" FontSize="12" FontWeight="Bold"/></Expander.Header>
        <Grid Margin="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ListBox x:Name="CallHistoryList" Height="56" DisplayMemberPath="text"/>
          <Button x:Name="SetHistoryCallTargetButton" Grid.Column="1" Content="设为PTT目标" Width="100" Height="27" Padding="5,2" Margin="5,1,0,0" IsEnabled="False" VerticalAlignment="Top"/>
        </Grid>
      </Expander>
    </Grid>

    <Grid x:Name="DashboardPanel" Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>

      <Border x:Name="ConnectionConfigPanel" Grid.Column="0" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="8" Margin="0,0,7,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="ConnectionScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel LastChildFill="False" Margin="1,0,0,4"><TextBlock Text="连接配置" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="DeviceDiscoveryText" DockPanel.Dock="Right" Text="" Foreground="#A8B5BB" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/></DockPanel>
            <TextBlock x:Name="ProfileMigrationText" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="呼号" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="CallsignBox"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Gateway ID" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="GatewayBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="本机 DMR ID" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="SourceBox"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="BM 服务器" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="MasterPresetBox" SelectedIndex="0"><ComboBoxItem Content="BM 4602 · 43.129.83.124" Tag="bm-china-4602"/><ComboBoxItem Content="自定义" Tag="custom"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="UDP 端口" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="MasterPortBox" Text="62031"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="主机名 / IPv4" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="MasterBox" Text="43.129.83.124"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="色码" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="ColorCodeBox"/></StackPanel>
            </Grid>
            <Border Background="#172024" BorderBrush="#3C494F" BorderThickness="1" Padding="5" Margin="0,2,0,3">
              <StackPanel>
                <DockPanel LastChildFill="False"><TextBlock Text="设备端口" FontWeight="Bold" FontSize="12"/><Button x:Name="RefreshDevicesButton" DockPanel.Dock="Right" Content="刷新" Width="44" Padding="4,2" Margin="0"/></DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Wires-X 串口" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="SerialBox"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="音频输入" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="WaveInEndpointBox"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="音频输出" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="WaveOutEndpointBox"/></StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Foreground="#A8B5BB" FontSize="12"><Run Text="BM API Key  "/><Hyperlink x:Name="BmApiKeySetupLink" Tag="bm_api_key" Foreground="#9BE0AE"><Run Text="设置"/></Hyperlink></TextBlock>
                <PasswordBox x:Name="BmApiKeyBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Foreground="#A8B5BB" FontSize="12"><Run Text="BM 密码  "/><Hyperlink x:Name="BmPasswordSetupLink" Tag="bm_password" Foreground="#9BE0AE"><Run Text="设置"/></Hyperlink></TextBlock>
                <PasswordBox x:Name="PasswordBox"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="SettingsErrorText" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Margin="2,3" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
          <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ConnectButton" Content="连接并应用" MinWidth="110" Background="#28583C" BorderBrush="#64A477"/>
            <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="保存配置" MinWidth="88"/>
            <TextBlock x:Name="ConnectionLockValue" Grid.Column="2" Text="" Foreground="#A8B5BB" FontSize="12" VerticalAlignment="Center" Margin="6,0,1,0"/>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="DailyControlsPanel" Grid.Column="1" Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="8" Margin="7,0,0,0">
        <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="日常控制" FontSize="14" FontWeight="Bold" Margin="1,0,0,4"/>
            <Border x:Name="ChannelConsolePanel" Background="#172024" BorderBrush="#46545B" BorderThickness="1" Padding="7" Margin="0,0,0,4">
              <StackPanel>
                <DockPanel><TextBlock Text="频道控制" FontWeight="Bold" FontSize="13"/><TextBlock x:Name="TransmitTargetValue" DockPanel.Dock="Right" Text="" Foreground="#9BE0AE" FontSize="12" FontWeight="Bold"/></DockPanel>
                <Grid Margin="0,3,0,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="频道 ID" Foreground="#A8B5BB" FontSize="12"/><TextBox x:Name="ChannelIdBox"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="类型" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="ChannelKindBox" SelectedIndex="0"><ComboBoxItem Content="请选择" Tag="unknown"/><ComboBoxItem Content="单呼" Tag="private"/><ComboBoxItem Content="组呼" Tag="group"/></ComboBox></StackPanel>
                  <Button x:Name="AddChannelButton" Grid.Column="2" Content="加入监听" Padding="8,5" Background="#28583C" BorderBrush="#64A477" VerticalAlignment="Bottom"/>
                </Grid>
                <CheckBox x:Name="MakeChannelTxTargetCheckBox" Content="同时设为PTT目标" IsChecked="False" Foreground="#EDF3F4" Margin="3,2,0,2"/>
                <TextBlock x:Name="ChannelStatusText" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Margin="2,2,0,0" Visibility="Collapsed"/>
                <Border x:Name="BmStaticGroupPanel" Background="#151C20" BorderBrush="#3C494F" BorderThickness="1" Padding="4" Margin="0,3,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="BM 静态组" FontSize="12" Foreground="#A8B5BB" VerticalAlignment="Center"/><TextBlock x:Name="BmStaticGroupSourceValue" Grid.Column="1" Text="" Foreground="#A8B5BB" FontSize="12" VerticalAlignment="Center"/>
                      <Button x:Name="RefreshBmStaticGroupsButton" Grid.Column="2" Content="刷新" Padding="6,2" Margin="1"/>
                      <Button x:Name="RemoveBmStaticGroupButton" Grid.Column="3" Content="移除" Padding="6,2" Margin="1" IsEnabled="False"/>
                    </Grid>
                    <ListBox x:Name="BmStaticGroupsList" Height="62" DisplayMemberPath="text"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="BmStaticGroupIdBox" Grid.Column="0" ToolTip="TG"/>
              <Button x:Name="AddBmStaticGroupButton" Grid.Column="1" Content="添加" Padding="7,3" IsEnabled="False"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="BmStaticGroupStatus" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <Border Background="#172024" BorderBrush="#46545B" BorderThickness="1" Padding="7" Margin="0,0,0,4">
              <StackPanel>
                <TextBlock Text="音量" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <DockPanel><TextBlock Text="播放增益" Foreground="#A8B5BB" FontSize="12"/><TextBlock x:Name="PlaybackGainValueText" DockPanel.Dock="Right" Text="" Foreground="#9BE0AE" FontWeight="Bold" Margin="0,0,6,0"/></DockPanel>
                    <Slider x:Name="PlaybackGainSlider" Minimum="0.25" Maximum="16" Value="1"/>
                    <TextBlock x:Name="PlaybackGainSavedValueText" Text="" Foreground="#9BA9AE" FontSize="12" Visibility="Collapsed"/>
                    <TextBlock x:Name="PlaybackGainRuntimeValueText" Text="" Foreground="#9BA9AE" FontSize="12" Visibility="Collapsed"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <DockPanel><TextBlock Text="发送增益" Foreground="#A8B5BB" FontSize="12"/><TextBlock x:Name="TransmitGainValueText" DockPanel.Dock="Right" Text="" Foreground="#9BE0AE" FontWeight="Bold" Margin="0,0,6,0"/></DockPanel>
                    <Slider x:Name="TransmitGainSlider" Minimum="0.25" Maximum="16" Value="16"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="PlaybackGainStatusValue" Text="" Foreground="#9BE0AE" FontSize="12" Margin="2,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <Border x:Name="CatOperatingPanel" Background="#172024" BorderBrush="#46545B" BorderThickness="1" Padding="7" Margin="0,0,0,4" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="电台控制" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <StackPanel x:Name="CatObservedPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,6,0">
                    <TextBlock x:Name="CatObservedMainModeText" Text="" Foreground="#9BE0AE" FontSize="12" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CatObservedFrequencyText" Text="" Foreground="#9BE0AE" FontSize="12" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CatObservedPowerText" Text="" Foreground="#A8B5BB" FontSize="12"/>
                  </StackPanel>
                </Grid>
                <Border x:Name="RadioCatPanel" Background="#151C20" BorderBrush="#3C494F" BorderThickness="1" Padding="4" Margin="0,3,0,3" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CAT 串口" Foreground="#A8B5BB" FontSize="11"/><ComboBox x:Name="CatPortBox" IsEditable="True" IsTextSearchEnabled="False"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="波特率" Foreground="#A8B5BB" FontSize="11"/><ComboBox x:Name="CatBaudRateBox"><ComboBoxItem Content="4800" Tag="4800"/><ComboBoxItem Content="9600" Tag="9600"/><ComboBoxItem Content="19200" Tag="19200"/><ComboBoxItem Content="38400" Tag="38400"/><ComboBoxItem Content="115200" Tag="115200"/></ComboBox></StackPanel>
                    <Button x:Name="CatConnectButton" Grid.Column="2" Content="连接串口" MinWidth="76" Padding="7,4" VerticalAlignment="Bottom"/>
                    <Button x:Name="CatDisconnectButton" Grid.Column="3" Content="断开串口" MinWidth="76" Padding="7,4" VerticalAlignment="Bottom" IsEnabled="False"/>
                    <TextBlock x:Name="CatSessionStatusText" Grid.Column="4" Text="未连接" Foreground="#A8B5BB" FontSize="12" VerticalAlignment="Center" Margin="8,0,2,0" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="CatMainModeBox" SelectedIndex="-1"><ComboBoxItem Content="FM" Tag="FM"/><ComboBoxItem Content="FM-N" Tag="FM-N"/><ComboBoxItem Content="C4FM-DN" Tag="C4FM-DN"/><ComboBoxItem Content="C4FM-VW" Tag="C4FM-VW"/></ComboBox>
                  <Button x:Name="ApplyCatModeButton" Grid.Column="1" Content="模式" MinWidth="58" Padding="6,3"/>
                  <TextBox x:Name="CatMainFrequencyMHzBox" Grid.Column="2"/>
                  <Button x:Name="ApplyCatFrequencyButton" Grid.Column="3" Content="频率" MinWidth="58" Padding="6,3"/>
                </Grid>
