<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="频道说明" Width="420" Height="185" MinWidth="390" MinHeight="170"
        WindowStartupLocation="CenterOwner" Background="#111619" Foreground="#EDF3F4"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF3F4"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F0F4F5"/><Setter Property="Background" Value="#2B383E"/><Setter Property="BorderBrush" Value="#718189"/><Setter Property="Padding" Value="9,5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="2"/></Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="频道说明" FontSize="16" FontWeight="Bold" Margin="2,0,0,8"/>
    <TextBlock Grid.Row="1" Text="现有频道继续使用已保存的网络参数。新加入的频道使用默认参数。" Foreground="#A8B5BB" FontSize="13" TextWrapping="Wrap" Margin="3,4"/>
    <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="CancelSettingsButton" Grid.Column="1" Content="关闭" MinWidth="78"/>
    </Grid>
  </Grid>
</Window>
