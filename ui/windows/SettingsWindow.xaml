<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIREX Bridge · 设置"
        Width="920" Height="880" MinWidth="760" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#141719" Foreground="#EDF1F2" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF1F2"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#191E21"/><Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="BorderBrush" Value="#4A555B"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,10,10"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#20252A"/><Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="BorderBrush" Value="#4A555B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,4,10,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Grid Margin="{TemplateBinding BorderThickness}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                <ContentPresenter x:Name="PART_SelectionBoxItem" IsHitTestVisible="False"
                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="#252B2F" BorderThickness="0">
                  <Path Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z"/>
                </ToggleButton>
              </Grid>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#20252A" BorderBrush="#536169" BorderThickness="1" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Background" Value="#20252A"/><Setter Property="Foreground" Value="#778288"/></Trigger>
              <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#87A9B6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#20252A"/><Setter Property="Foreground" Value="#EDF1F2"/><Setter Property="Padding" Value="8,6"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#344148"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#355A42"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#191E21"/><Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="BorderBrush" Value="#4A555B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="Padding" Value="4,2"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#355A42"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="#77B18D"/><Setter Property="Margin" Value="0,7,10,9"/>
      <Setter Property="IsSnapToTickEnabled" Value="False"/><Setter Property="TickFrequency" Value="0.01"/>
      <Setter Property="SmallChange" Value="0.05"/><Setter Property="LargeChange" Value="0.5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#30383E"/><Setter Property="Foreground" Value="#EDF1F2"/>
      <Setter Property="BorderBrush" Value="#536169"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#87A9B6"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#273238"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#252B2F"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#394147"/>
                <Setter Property="Foreground" Value="#778288"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#252B2F"/><Setter Property="Foreground" Value="#778288"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="连接、路由与音量设置" FontSize="21" FontWeight="Bold"/>
      <TextBlock Text="连接参数下次启动生效；运行中的 RX 策略和 TX 目标经核心确认后立即生效。" Foreground="#9DA8AD" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="BrandMeister 连接" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="ProfileMigrationText" Text="新配置将保存为 schema 2。" Foreground="#E1AE53" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="呼号" Foreground="#AAB5BA"/><TextBox x:Name="CallsignBox"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Gateway ID" Foreground="#AAB5BA"/><TextBox x:Name="GatewayBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Source ID" Foreground="#AAB5BA"/><TextBox x:Name="SourceBox"/></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="服务器预设" Foreground="#AAB5BA"/><ComboBox x:Name="MasterPresetBox" SelectedIndex="1"><ComboBoxItem Content="BM China 4602 · 43.129.83.124:62031" Tag="bm-china-4602"/><ComboBoxItem Content="自定义服务器" Tag="custom"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="UDP 端口" Foreground="#AAB5BA"/><TextBox x:Name="MasterPortBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="发射目标 ID" Foreground="#AAB5BA"/><TextBox x:Name="DestinationBox"/></StackPanel>
            </Grid>
            <StackPanel><TextBlock Text="Master IPv4 / 主机名" Foreground="#AAB5BA"/><TextBox x:Name="MasterBox"/></StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="时隙" Foreground="#AAB5BA"/><ComboBox x:Name="SlotBox" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Color Code" Foreground="#AAB5BA"/><TextBox x:Name="ColorCodeBox"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="呼叫类型" Foreground="#AAB5BA"/><ComboBox x:Name="CallKindBox" SelectedIndex="0"><ComboBoxItem Content="组呼" Tag="group"/><ComboBoxItem Content="单呼" Tag="private"/></ComboBox></StackPanel>
            </Grid>
            <Button x:Name="ApplyNextTxTargetButton" Content="设为下一发射目标" HorizontalAlignment="Left" MinWidth="180"/>
            <CheckBox x:Name="TransmitEnabledBox" Content="允许向 BrandMeister 发射" IsChecked="True" Foreground="#EDF1F2" Margin="0,2,0,0"/>
            <TextBlock Text="TG91 与 TG46001 是只收组呼；它们不能设为发射目标。接收策略与下一发射目标可分别调整。" Foreground="#9DA8AD" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="本机接收策略" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="ReceivePolicyPreviewText" Text="接收策略：新配置" Foreground="#8CC9A1" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="组呼模式" Foreground="#AAB5BA"/><ComboBox x:Name="GroupModeBox"><ComboBoxItem Content="Selected · 只收列表中的 TG/TS" Tag="selected"/><ComboBoxItem Content="AllDelivered · 收已送达组呼" Tag="all_delivered"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="私呼模式" Foreground="#AAB5BA"/><ComboBox x:Name="PrivateModeBox"><ComboBoxItem Content="关闭私呼" Tag="disabled"/><ComboBoxItem Content="只收指定 peer" Tag="selected_peers"/><ComboBoxItem Content="收发往本机的私呼" Tag="all_peers_to_local"/></ComboBox></StackPanel>
            </Grid>
            <TextBlock Text="Selected 组呼路由" FontWeight="Bold" Margin="0,4,0,2"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="GroupRouteIdBox" ToolTip="Talkgroup ID"/>
              <ComboBox x:Name="GroupRouteSlotBox" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddGroupRouteButton" Grid.Column="2" Content="加入"/>
              <Button x:Name="RemoveGroupRouteButton" Grid.Column="3" Content="移除"/>
            </Grid>
            <ListBox x:Name="GroupRoutesList" Height="56" Margin="0,0,0,6"/>
            <TextBlock Text="组呼屏蔽（按 TG + TS）" FontWeight="Bold" Margin="0,2,0,2"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="BlockedGroupIdBox" ToolTip="Talkgroup ID"/>
              <ComboBox x:Name="BlockedGroupSlotBox" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddBlockedGroupButton" Grid.Column="2" Content="屏蔽"/>
              <Button x:Name="RemoveBlockedGroupButton" Grid.Column="3" Content="恢复"/>
            </Grid>
            <ListBox x:Name="BlockedGroupsList" Height="48" Margin="0,0,0,6"/>
            <TextBlock Text="精确私呼 peer（对端 Source ID / 本机 Source ID / TS）" FontWeight="Bold" Margin="0,2,0,2"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="PeerSourceIdBox" ToolTip="对端 Source ID"/>
              <TextBox x:Name="PeerLocalDestinationBox" Grid.Column="1" ToolTip="必须等于本机 Source ID"/>
              <ComboBox x:Name="PeerSlotBox" Grid.Column="2" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddPeerRouteButton" Grid.Column="3" Content="加入 peer"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ListBox x:Name="PeerRoutesList" Height="48" Margin="0,0,6,6"/>
              <Button x:Name="RemovePeerRouteButton" Grid.Column="1" Content="移除" VerticalAlignment="Top"/>
            </Grid>
            <TextBlock Text="本机私呼接收（任意来源）" FontWeight="Bold" Margin="0,2,0,2"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="LocalPrivateDestinationBox" ToolTip="必须等于本机 Source ID"/>
              <ComboBox x:Name="LocalPrivateSlotBox" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddLocalPrivateRouteButton" Grid.Column="2" Content="加入路由"/>
              <Button x:Name="RemoveLocalPrivateRouteButton" Grid.Column="3" Content="移除"/>
            </Grid>
            <ListBox x:Name="LocalPrivateRoutesList" Height="48" Margin="0,0,0,6"/>
            <TextBlock Text="跨组来源屏蔽（Source ID）" FontWeight="Bold" Margin="0,2,0,2"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="BlockedSourceIdBox" ToolTip="发话人 Source ID"/>
              <Button x:Name="AddBlockedSourceButton" Grid.Column="1" Content="屏蔽来源"/>
              <Button x:Name="RemoveBlockedSourceButton" Grid.Column="2" Content="恢复来源"/>
            </Grid>
            <ListBox x:Name="BlockedSourcesList" Height="48" Margin="0,0,0,6"/>
            <TextBlock x:Name="RoutingEditorStatus" Text="离线编辑将在保存后用于下一次启动。" Foreground="#9DA8AD" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="设备选择" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="列表显示设备名称、COM 端口和稳定音频端点标识；已保存的固定设备缺失时会保留缺失提示。" Foreground="#9DA8AD" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <TextBlock x:Name="DeviceDiscoveryText" Text="设备列表尚未读取。" Foreground="#9DA8AD" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <Button x:Name="RefreshDevicesButton" Content="刷新设备" HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,7"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="HRI 串口" Foreground="#AAB5BA"/><ComboBox x:Name="SerialBox"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="电台音频输入" Foreground="#AAB5BA"/><ComboBox x:Name="WaveInEndpointBox"/></StackPanel>
            </Grid>
            <StackPanel><TextBlock Text="电台音频输出" Foreground="#AAB5BA"/><ComboBox x:Name="WaveOutEndpointBox"/></StackPanel>
          </StackPanel>
        </Border>
        <Border Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="音量" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <DockPanel><TextBlock Text="BM 到电台播放增益" Foreground="#AAB5BA"/><TextBlock x:Name="PlaybackGainValueText" DockPanel.Dock="Right" Foreground="#8CC9A1" FontWeight="Bold" Margin="0,0,10,0"/></DockPanel>
                <Slider x:Name="PlaybackGainSlider" Minimum="0.25" Maximum="16" Value="1"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <DockPanel><TextBlock Text="手咪到 BM 发送增益" Foreground="#AAB5BA"/><TextBlock x:Name="TransmitGainValueText" DockPanel.Dock="Right" Foreground="#8CC9A1" FontWeight="Bold" Margin="0,0,10,0"/></DockPanel>
                <Slider x:Name="TransmitGainSlider" Minimum="0.25" Maximum="16" Value="16"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="保存后，下次连接时使用新设置。默认值：播放 1x，发送 16x。" Foreground="#9DA8AD"/>
          </StackPanel>
        </Border>
        <Border Background="#20252A" BorderBrush="#3A4248" BorderThickness="1" Padding="14">
          <StackPanel>
            <TextBlock Text="BM 密码文件" FontSize="14" FontWeight="Bold" Margin="0,0,0,7"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="PasswordPathBox" Margin="0,4,6,4"/>
              <Button x:Name="BrowsePasswordButton" Grid.Column="1" Content="选择文件"/>
            </Grid>
            <TextBlock Text="选择本机 BM 密码文件；启动桥接时使用该文件。" Foreground="#9DA8AD"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SettingsErrorText" Text="保存后，下次连接时使用新设置。" Foreground="#9DA8AD" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4"/>
      <Button x:Name="CancelSettingsButton" Grid.Column="1" Content="取消" MinWidth="90"/>
      <Button x:Name="SaveSettingsButton" Grid.Column="2" Content="保存设置" MinWidth="130" Background="#355A42" BorderBrush="#55785F"/>
    </Grid>
  </Grid>
</Window>
