<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIREX Bridge · 路由策略" Width="820" Height="700" MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#111619" Foreground="#EDF3F4"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF3F4"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#F2F6F7"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="2,1"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F2F6F7"/><Setter Property="Background" Value="#12191C"/>
      <Setter Property="BorderBrush" Value="#64747C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
              <ContentPresenter x:Name="PART_SelectionBoxItem" Margin="7,0,29,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Margin="5,1,29,1" Padding="1,0" VerticalContentAlignment="Center"/>
              <ToggleButton x:Name="DropDownToggle" Width="25" HorizontalAlignment="Right" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ArrowChrome" Background="Transparent" CornerRadius="1">
                      <TextBlock Text="▾" Foreground="#E6EEF0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#34474F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#28533B"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#182126" BorderBrush="#64747C" BorderThickness="1" MaxHeight="240" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer Margin="1" CanContentScroll="True" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_SelectionBoxItem" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9BE0AE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#20272B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#3D484D"/><Setter Property="Foreground" Value="#8A969B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#182126"/><Setter Property="Foreground" Value="#F2F6F7"/><Setter Property="Padding" Value="7,5"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#12191C"/><Setter Property="Foreground" Value="#E6EEF0"/><Setter Property="BorderBrush" Value="#526169"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="3"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F0F4F5"/><Setter Property="Background" Value="#2B383E"/>
      <Setter Property="BorderBrush" Value="#718189"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="2"/>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="1,0,0,8"><TextBlock Text="路由策略" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="ReceivePolicyPreviewText" Text="" DockPanel.Dock="Right" Foreground="#9BE0AE" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/></DockPanel>
    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="8" Margin="0,0,0,6">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="组呼收听" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="GroupModeBox"><ComboBoxItem Content="指定组呼" Tag="selected"/><ComboBoxItem Content="全部已送达组呼" Tag="all_delivered"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="私呼收听" Foreground="#A8B5BB" FontSize="12"/><ComboBox x:Name="PrivateModeBox"><ComboBoxItem Content="关闭" Tag="disabled"/><ComboBoxItem Content="指定对端" Tag="selected_peers"/><ComboBoxItem Content="发往本机" Tag="all_peers_to_local"/></ComboBox></StackPanel>
            </Grid>
            <TextBlock Text="指定组呼" FontWeight="Bold" FontSize="12" Margin="2,5,0,1"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="GroupRouteIdBox" ToolTip="TG"/>
              <ComboBox x:Name="GroupRouteSlotBox" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddGroupRouteButton" Grid.Column="2" Content="加入"/>
              <Button x:Name="RemoveGroupRouteButton" Grid.Column="3" Content="移除"/>
            </Grid>
            <ListBox x:Name="GroupRoutesList" Height="56" Margin="2,1,2,5"/>
            <TextBlock Text="组呼屏蔽" FontWeight="Bold" FontSize="12" Margin="2,1,0,1"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="BlockedGroupIdBox" ToolTip="TG"/>
              <ComboBox x:Name="BlockedGroupSlotBox" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddBlockedGroupButton" Grid.Column="2" Content="屏蔽"/>
              <Button x:Name="RemoveBlockedGroupButton" Grid.Column="3" Content="恢复"/>
            </Grid>
            <ListBox x:Name="BlockedGroupsList" Height="48" Margin="2,1,2,2"/>
          </StackPanel>
        </Border>
        <Border Background="#1D2529" BorderBrush="#46545B" BorderThickness="1" Padding="8" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock Text="私呼对端" FontWeight="Bold" FontSize="12" Margin="2,0,0,2"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="PeerSourceIdBox" ToolTip="对端 ID"/>
              <TextBox x:Name="PeerLocalDestinationBox" Grid.Column="1" ToolTip="本机 ID"/>
              <ComboBox x:Name="PeerSlotBox" Grid.Column="2" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddPeerRouteButton" Grid.Column="3" Content="加入"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ListBox x:Name="PeerRoutesList" Height="48" Margin="2,1,5,4"/>
              <Button x:Name="RemovePeerRouteButton" Grid.Column="1" Content="移除" VerticalAlignment="Top"/>
            </Grid>
            <TextBlock Text="本机私呼接收" FontWeight="Bold" FontSize="12" Margin="2,1,0,1"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="LocalPrivateDestinationBox" ToolTip="本机 ID"/>
              <ComboBox x:Name="LocalPrivateSlotBox" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="TS1" Tag="1"/><ComboBoxItem Content="TS2" Tag="2"/></ComboBox>
              <Button x:Name="AddLocalPrivateRouteButton" Grid.Column="2" Content="加入"/>
              <Button x:Name="RemoveLocalPrivateRouteButton" Grid.Column="3" Content="移除"/>
            </Grid>
            <ListBox x:Name="LocalPrivateRoutesList" Height="48" Margin="2,1,2,4"/>
            <TextBlock Text="跨组来源屏蔽" FontWeight="Bold" FontSize="12" Margin="2,1,0,1"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="BlockedSourceIdBox" ToolTip="发话人 ID"/>
              <Button x:Name="AddBlockedSourceButton" Grid.Column="1" Content="屏蔽来源"/>
              <Button x:Name="RemoveBlockedSourceButton" Grid.Column="2" Content="恢复来源"/>
            </Grid>
            <ListBox x:Name="BlockedSourcesList" Height="48" Margin="2,1,2,2"/>
            <TextBlock x:Name="RoutingEditorStatus" Text="" Foreground="#EFC36F" FontSize="12" TextWrapping="Wrap" Margin="2,3" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text=""/>
      <Button x:Name="CancelSettingsButton" Grid.Column="1" Content="关闭" MinWidth="92"/>
    </Grid>
  </Grid>
</Window>
